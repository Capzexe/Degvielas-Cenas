# Adapt paths and TLS certificate names before installing. No wildcard hosts.
server {
    listen 80;
    server_name example.com;
    return 308 https://example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name example.com;
    root /var/www/cenalitra/public;
    index index.php;
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    server_tokens off;
    client_max_body_size 6m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # Laravel emits its per-request nonce CSP on dynamic responses.
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php { deny all; }
    location ~ /\.(?!well-known) { deny all; }
    location ~* \.(?:env|ini|log|sql|sqlite|bak|zip|tar|gz)$ { deny all; }
}
